# ===== AI (OpenAI-compatible) =====
# Endpoint dạng OpenAI-compatible, ví dụ:
#   GLM (Zhipu, Trung Quốc):  https://open.bigmodel.cn/api/paas/v4
#   GLM (Z.ai quốc tế):       https://api.z.ai/api/paas/v4
#   OpenAI:                   https://api.openai.com/v1
#   Ollama local:             http://localhost:11434/v1
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4.6

# Lưu ý: không cấu hình AI_API_KEY thì scanner vẫn chạy bình thường,
# chỉ có tính năng "sinh code fix" và "tạo PR" là bị tắt.

# ===== Server =====
PORT=3000

# ===== GitHub OAuth (tuỳ chọn) =====
# Đăng nhập bằng GitHub thay vì dán PAT tay. Cấu hình tại
# https://github.com/settings/developers → "New OAuth App":
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/github/callback
# Rồi dán Client ID / Client Secret vào đây và restart app.
# Access token chỉ nằm trong RAM (8 tiếng) — không lưu xuống đĩa.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# Chỉ cần khi app chạy sau proxy/domain khác localhost (mặc định: lấy từ origin request)
#WPSA_PUBLIC_URL=http://localhost:3000

# ===== Job store (SQLite) =====
# Đường dẫn file DB lưu lịch sử scan (mặc định: apps/web/.data/wpsa-jobs.db)
#WPSA_DB_PATH=D:\duong\dan\wpsa-jobs.db
# Số giờ giữ job trước khi dọn (mặc định: 6)
#WPSA_JOB_TTL_HOURS=6
